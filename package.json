{
  "name": "electron-vue-ts-sample",
  "version": "0.1.0",
  "description": "Electron + Vue 3 + TypeScript サンプルアプリ",
  "main": "./out/main/index.js",
  "homepage": "https://example.com/electron-vue-ts-sample",
  "author": "example",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "dev:web": "vite dev --config vite.config.web.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "preview": "node scripts/run-electron-vite.mjs preview",
    "preview:web": "vite preview --config vite.config.web.ts",
    "dist:linux": "npm run build && electron-builder --linux",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@mdi/font": "^7.4.47",
    "exceljs": "^4.4.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "vuetify": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@vue/test-utils": "^2.4.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.10.0",
    "eslint-plugin-vue": "^9.28.0",
    "globals": "^15.9.0",
    "husky": "^9.1.0",
    "jsdom": "^25.0.0",
    "lint-staged": "^15.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix"
    ]
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true
  }
}
