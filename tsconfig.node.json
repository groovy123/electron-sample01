{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["electron-vite/node"],
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "electron.vite.config.ts",
    "vite.config.web.ts",
    "vitest.config.ts",
    "config/**/*",
    "src/main/**/*",
    "src/preload/**/*"
  ]
}
